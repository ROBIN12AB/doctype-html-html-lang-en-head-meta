  "messages": [
    {
      "id": "762d6ed6-94cc-433f-a352-3feb5fd5d790",
      "role": "user",
      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>IU FCIS Past Exam Papers Archive | Final Exam Preparation Portal</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n    body { font-family: 'Inter', sans-serif; }\n    .modal-backdrop { background-color: rgba(15, 23, 42, 0.72); }\n  </style>\n</head>\n<body class=\"bg-slate-50 text-slate-800 min-h-screen flex flex-col\">\n\n  <!-- Top Academic Banner -->\n  <div class=\"bg-slate-900 text-slate-300 text-xs py-2 px-4 border-b border-slate-800\">\n    <div class=\"max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-2\">\n      <span>Islamic University of Madinah • Faculty of Computer &amp; Information Systems (FCIS)</span>\n      <span class=\"text-sky-400 font-medium\">Built with Google Antigravity v2.0 • Group 2 (CIT 3110)</span>\n    </div>\n  </div>\n\n  <!-- Navigation Header -->\n  <header class=\"bg-white border-b border-slate-200 sticky top-0 z-20\">\n    <div class=\"max-w-6xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-4\">\n      <div class=\"flex items-center gap-3\">\n        <div class=\"w-10 h-10 rounded-lg bg-blue-700 text-white flex items-center justify-center font-bold text-lg\">\n          IU\n        </div>\n        <div>\n          <h1 class=\"text-lg font-bold text-slate-900 leading-tight\">FCIS Past Exam Papers Portal</h1>\n          <p class=\"text-xs text-slate-500\">Previous Years' Final &amp; Midterm Questions Archive</p>\n        </div>\n      </div>\n\n      <div class=\"flex items-center gap-3\">\n        <span id=\"savedCounterBadge\" class=\"text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 px-3 py-1.5 rounded-full\">\n          Saved for Revision: 0\n        </span>\n        <button id=\"PracticeQuizBtn\" onclick=\"openQuickQuiz()\" class=\"bg-blue-700 hover:bg-blue-800 text-white text-xs font-semibold px-4 py-2 rounded-lg transition\">\n          Quick Self-Test Mode\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Hero & Search Filter Section -->\n  <section class=\"bg-gradient-to-b from-slate-900 to-slate-800 text-white py-10 px-4\">\n    <div class=\"max-w-6xl mx-auto\">\n      <div class=\"max-w-3xl\">\n        <span class=\"inline-block text-xs font-semibold uppercase tracking-wider bg-blue-500/20 text-sky-300 border border-sky-400/30 px-3 py-1 rounded-full mb-3\">\n          Final Exam Preparation Hub\n        </span>\n        <h2 class=\"text-2xl sm:text-3xl font-bold tracking-tight mb-2\">\n          Search Previous Years' University Exam Questions &amp; Model Solutions\n        </h2>\n        <p class=\"text-slate-300 text-sm mb-6\">\n          Filter past final and midterm examination papers by course code, academic year, or topic keyword. Practice with real questions and check step-by-step model answer keys before your final exam.\n        </p>\n      </div>\n\n      <!-- Search & Filter Bar -->\n      <div class=\"bg-white p-3 rounded-xl shadow-sm border border-slate-200 grid grid-cols-1 md:grid-cols-12 gap-3 text-slate-800\">\n        <div class=\"md:col-span-5 relative\">\n          <label for=\"searchInput\" class=\"sr-only\">Search by Course Code, Title, or Topic</label>\n          <input\n            id=\"searchInput\"\n            type=\"text\"\n            placeholder=\"Search course (e.g., CIT 3110, SQL, Networking, Python)...\"\n            class=\"w-full pl-3 pr-3 py-2.5 text-sm border border-slate-200 rounded-lg focus:outline-none focus:border-blue-600\"\n            oninput=\"filterPapers()\"\n          />\n        </div>\n\n        <div class=\"md:col-span-3\">\n          <label for=\"departmentSelect\" class=\"sr-only\">Department</label>\n          <select id=\"departmentSelect\" onchange=\"filterPapers()\" class=\"w-full py-2.5 px-3 text-sm border border-slate-200 rounded-lg bg-white focus:outline-none focus:border-blue-600\">\n            <option value=\"ALL\">All Departments (CS, IS, IT)</option>\n            <option value=\"CIT\">Information Technology (CIT)</option>\n            <option value=\"CS\">Computer Science (CS)</option>\n            <option value=\"IS\">Information Systems (IS)</option>\n          </select>\n        </div>\n\n        <div class=\"md:col-span-2\">\n          <label for=\"yearSelect\" class=\"sr-only\">Academic Year</label>\n          <select id=\"yearSelect\" onchange=\"filterPapers()\" class=\"w-full py-2.5 px-3 text-sm border border-slate-200 rounded-lg bg-white focus:outline-none focus:border-blue-600\">\n            <option value=\"ALL\">All Years</option>\n            <option value=\"2025\">2025 – 2026</option>\n            <option value=\"2024\">2024 – 2025</option>\n            <option value=\"2023\">2023 – 2024</option>\n          </select>\n        </div>\n\n        <div class=\"md:col-span-2\">\n          <button onclick=\"resetFilters()\" class=\"w-full py-2.5 px-3 text-sm font-medium text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition\">\n            Reset Filters\n          </button>\n        </div>\n      </div>\n\n      <!-- Quick Course Filter Pills -->\n      <div class=\"flex flex-wrap items-center gap-2 mt-4 text-xs\">\n        <span class=\"text-slate-400\">Quick Course Filter:</span>\n        <button onclick=\"setQuickCourse('ALL')\" class=\"px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition\">All Courses</button>\n        <button onclick=\"setQuickCourse('CIT 3110')\" class=\"px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-sky-300 border border-slate-700 transition\">CIT 3110 (Digital Tools)</button>\n        <button onclick=\"setQuickCourse('CS 2201')\" class=\"px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-sky-300 border border-slate-700 transition\">CS 2201 (Data Structures)</button>\n        <button onclick=\"setQuickCourse('IS 3102')\" class=\"px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-sky-300 border border-slate-700 transition\">IS 3102 (Database Systems)</button>\n        <button onclick=\"setQuickCourse('CIT 2405')\" class=\"px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-sky-300 border border-slate-700 transition\">CIT 2405 (Computer Networks)</button>\n      </div>\n    </div>\n  </section>\n\n  <!-- Main Content Area -->\n  <main class=\"max-w-6xl mx-auto px-4 py-8 flex-1 w-full\">\n    <div class=\"flex flex-wrap justify-between items-center mb-5 gap-2\">\n      <div>\n        <h3 class=\"text-base font-bold text-slate-900\" id=\"resultsCountHeading\">Showing 6 Past Exam Papers</h3>\n        <p class=\"text-xs text-slate-500\">Click \"View Questions &amp; Answer Key\" on any paper to practice and reveal official solutions.</p>\n      </div>\n      <div class=\"flex items-center gap-2\">\n        <button id=\"showSavedOnlyBtn\" onclick=\"toggleSavedFilter()\" class=\"text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 transition\">\n          Show Saved Papers Only\n        </button>\n      </div>\n    </div>\n\n    <!-- Exam Paper Cards Grid -->\n    <div id=\"papersGrid\" class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n      <!-- Dynamically populated by JavaScript -->\n    </div>\n  </main>\n\n  <!-- Exam Question & Solution Viewer Modal -->\n  <div id=\"paperModal\" class=\"fixed inset-0 modal-backdrop hidden items-center justify-center z-50 p-4\">\n    <div class=\"bg-white rounded-xl max-w-3xl w-full max-h-[90vh] flex flex-col border border-slate-200 overflow-hidden\">\n      <div class=\"px-6 py-4 bg-slate-900 text-white flex justify-between items-start gap-4\">\n        <div>\n          <span id=\"modalBadge\" class=\"text-xs font-semibold uppercase tracking-wider text-sky-300\"></span>\n          <h4 id=\"modalTitle\" class=\"text-lg font-bold mt-0.5\"></h4>\n          <p id=\"modalMeta\" class=\"text-xs text-slate-300 mt-1\"></p>\n        </div>\n        <button onclick=\"closePaperModal()\" class=\"text-slate-300 hover:text-white text-sm font-semibold px-2.5 py-1 rounded border border-slate-700\">\n          Close ✕\n        </button>\n      </div>\n\n      <div class=\"p-6 overflow-y-auto space-y-5 flex-1\" id=\"modalQuestionsContainer\">\n        <!-- Populated dynamically -->\n      </div>\n\n      <div class=\"px-6 py-3 bg-slate-50 border-t border-slate-200 flex flex-wrap justify-between items-center gap-3\">\n        <span class=\"text-xs text-slate-500\">Tip: Try answering each question on paper before clicking \"Show Model Answer\".</span>\n        <div class=\"flex items-center gap-2\">\n          <button onclick=\"toggleAllAnswers(true)\" class=\"text-xs font-semibold px-3 py-1.5 rounded bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100\">\n            Reveal All Answers\n          </button>\n          <button onclick=\"window.print()\" class=\"text-xs font-semibold px-3 py-1.5 rounded bg-slate-800 text-white hover:bg-slate-900\">\n            Print / Save Exam PDF\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Footer -->\n  <footer class=\"bg-white border-t border-slate-200 py-6 px-4 mt-12\">\n    <div class=\"max-w-6xl mx-auto flex flex-wrap justify-between items-center text-xs text-slate-500 gap-4\">\n      <div>\n        <strong class=\"text-slate-800\">CIT 3110 Group Project – Group 2</strong> • Built with Google Antigravity IDE v2.0\n      </div>\n      <div>\n        Team: Osama Ahmed (461033163) • Faizan Khalid (471036733) • Md Robin Hossain (4610276638) • Ahbab Hasan Akib (461031613)\n      </div>\n    </div>\n  </footer>\n\n  <script>\n    const examPapers = [\n      {\n        id: \"cit3110-final-2025\",\n        courseCode: \"CIT 3110\",\n        courseTitle: \"Explore a Digital Tool or Technology\",\n        department: \"CIT\",\n        year: \"2025\",\n        semester: \"First Semester 2025–2026\",\n        examType: \"Final Exam\",\n        duration: \"120 Mins\",\n        totalMarks: \"40 Marks\",\n        difficulty: \"Moderate\",\n        topics: [\"Agentic IDEs\", \"Prompt Engineering\", \"Cloud Privacy\", \"Software Evaluation\"],\n        questions: [\n          {\n            qNum: \"Q1 (10 Marks)\",\n            question: \"Explain the primary difference between a traditional code autocomplete extension and an agent-first development environment such as Google Antigravity.\",\n            answer: \"A traditional autocomplete tool only suggests single lines or snippets inside an active text file. In contrast, an agent-first IDE like Google Antigravity uses autonomous AI agents to create structured multi-step plans (tasks.md and implementation_plan.md), create and edit multiple project files, run terminal commands in a sandbox, and verify results in an integrated browser.\"\n          },\n          {\n            qNum: \"Q2 (15 Marks)\",\n            question: \"What are Interactive Artifacts in Google Antigravity, and how do they help a beginner verify a web application without reading hundreds of lines of raw code?\",\n            answer: \"Interactive Artifacts are structured outputs generated by the AI agent—such as task checklists, implementation plans, file comparison diffs, and live browser screenshots. Beginners can review these visual summaries and leave inline comments directly on an Artifact to request layout adjustments without manually debugging complex code.\"\n          },\n          {\n            qNum: \"Q3 (15 Marks)\",\n            question: \"State two privacy or security precautions a university student must follow when using a cloud-connected AI coding tool.\",\n            answer: \"(1) Never include sensitive personal data, real student IDs, or private API keys/passwords in prompts or workspace files sent to cloud models. (2) Keep 'Strict / Sandboxed Mode' enabled so the AI agent cannot run terminal commands or modify system files without explicit human approval.\"\n          }\n        ]\n      },\n      {\n        id: \"is3102-final-2025\",\n        courseCode: \"IS 3102\",\n        courseTitle: \"Database Management Systems\",\n        department: \"IS\",\n        year: \"2025\",\n        semester: \"Second Semester 2025–2026\",\n        examType: \"Final Exam\",\n        duration: \"120 Mins\",\n        totalMarks: \"50 Marks\",\n        difficulty: \"High\",\n        topics: [\"SQL Joins\", \"3NF Normalization\", \"ER Diagrams\", \"ACID Transactions\"],\n        questions: [\n          {\n            qNum: \"Q1 (15 Marks)\",\n            question: \"Write an SQL query to list all students (StudentID, FullName) who scored above 85 in the course 'IS 3102' ordered by highest score first.\",\n            answer: \"SELECT s.StudentID, s.FullName, e.Score FROM Students s JOIN Enrollments e ON s.StudentID = e.StudentID WHERE e.CourseCode = 'IS 3102' AND e.Score > 85 ORDER BY e.Score DESC;\"\n          },\n          {\n            qNum: \"Q2 (20 Marks)\",\n            question: \"When is a relational table in Third Normal Form (3NF)? Give one example of a transitive dependency violation and how to fix it.\",\n            answer: \"A table is in 3NF if it is in 2NF and no non-prime attribute is transitively dependent on the primary key. For example, storing (StudentID, DepartmentID, DepartmentBuilding) violates 3NF because DepartmentBuilding depends on DepartmentID. Splitting Departments into a separate table fixes the anomaly.\"\n          },\n          {\n            qNum: \"Q3 (15 Marks)\",\n            question: \"Define the four ACID properties of a database transaction.\",\n            answer: \"Atomicity (all operations succeed or none do), Consistency (database moves from one valid state to another), Isolation (concurrent transactions do not interfere), and Durability (committed changes persist even after a power failure).\"\n          }\n        ]\n      },\n      {\n        id: \"cs2201-final-2024\",\n        courseCode: \"CS 2201\",\n        courseTitle: \"Data Structures & Algorithms\",\n        department: \"CS\",\n        year: \"2024\",\n        semester: \"First Semester 2024–2025\",\n        examType: \"Final Exam\",\n        duration: \"120 Mins\",\n        totalMarks: \"50 Marks\",\n        difficulty: \"High\",\n        topics: [\"Binary Search Trees\", \"Time Complexity\", \"Hash Tables\", \"Graph BFS/DFS\"],\n        questions: [\n          {\n            qNum: \"Q1 (15 Marks)\",\n            question: \"Compare the worst-case and average-case time complexity of searching for a key in a Binary Search Tree (BST) versus a Hash Table.\",\n            answer: \"In a balanced BST, average search takes O(log n), while a skewed BST degrades to O(n) in the worst case. A Hash Table provides O(1) average search time and O(n) worst-case time when hash collisions place all keys in one bucket.\"\n          },\n          {\n            qNum: \"Q2 (20 Marks)\",\n            question: \"Which data structure is used internally to implement Breadth-First Search (BFS) versus Depth-First Search (DFS) on a graph?\",\n            answer: \"Breadth-First Search (BFS) uses a First-In-First-Out (FIFO) Queue to explore nodes level by level. Depth-First Search (DFS) uses a Last-In-First-Out (LIFO) Stack (or recursion call stack).\"\n          }\n        ]\n      },\n      {\n        id: \"cit2405-final-2025\",\n        courseCode: \"CIT 2405\",\n        courseTitle: \"Computer Networks & Data Communications\",\n        department: \"CIT\",\n        year: \"2025\",\n        semester: \"First Semester 2025–2026\",\n        examType: \"Final Exam\",\n        duration: \"120 Mins\",\n        totalMarks: \"45 Marks\",\n        difficulty: \"Moderate\",\n        topics: [\"OSI 7 Layers\", \"TCP vs UDP\", \"IPv4 Subnetting\", \"DNS & HTTP\"],\n        questions: [\n          {\n            qNum: \"Q1 (15 Marks)\",\n            question: \"State three key differences between TCP and UDP at the Transport Layer.\",\n            answer: \"(1) TCP is connection-oriented (3-way handshake), whereas UDP is connectionless. (2) TCP guarantees reliable, ordered delivery with retransmission, while UDP is best-effort. (3) TCP has higher header overhead (20 bytes minimum) compared to UDP's 8-byte header.\"\n          },\n          {\n            qNum: \"Q2 (15 Marks)\",\n            question: \"Given the network address 192.168.10.0/26, how many usable host IP addresses are available per subnet?\",\n            answer: \"A /26 prefix leaves 32 - 26 = 6 host bits. Total addresses = 2^6 = 64. Subtracting the network and broadcast addresses leaves 64 - 2 = 62 usable host IP addresses.\"\n          }\n        ]\n      },\n      {\n        id: \"cs2201-midterm-2025\",\n        courseCode: \"CS 2201\",\n        courseTitle: \"Data Structures & Algorithms\",\n        department: \"CS\",\n        year: \"2025\",\n        semester: \"First Semester 2025–2026\",\n        examType: \"Midterm Exam\",\n        duration: \"60 Mins\",\n        totalMarks: \"25 Marks\",\n        difficulty: \"Moderate\",\n        topics: [\"Linked Lists\", \"Stacks & Queues\", \"Big-O Notation\"],\n        questions: [\n          {\n            qNum: \"Q1 (12 Marks)\",\n            question: \"Why is inserting a new node at the head of a singly linked list O(1), while inserting at the head of a dynamic array is O(n)?\",\n            answer: \"Inserting at the head of a singly linked list only requires updating two pointers (newNode.next = head; head = newNode), which takes constant O(1) time. In a dynamic array, all existing n elements must be shifted one index to the right, taking O(n) linear time.\"\n          }\n        ]\n      },\n      {\n        id: \"is3102-final-2023\",\n        courseCode: \"IS 3102\",\n        courseTitle: \"Database Management Systems\",\n        department: \"IS\",\n        year: \"2023\",\n        semester: \"Second Semester 2023–2024\",\n        examType: \"Final Exam\",\n        duration: \"120 Mins\",\n        totalMarks: \"50 Marks\",\n        difficulty: \"Moderate\",\n        topics: [\"Primary & Foreign Keys\", \"GROUP BY & HAVING\", \"Views & Indexes\"],\n        questions: [\n          {\n            qNum: \"Q1 (15 Marks)\",\n            question: \"What is the difference between the WHERE clause and the HAVING clause in an SQL query?\",\n            answer: \"WHERE filters individual rows before grouping (GROUP BY) and cannot contain aggregate functions. HAVING filters grouped summary rows after GROUP BY has been applied and can filter on aggregate functions like COUNT() or AVG().\"\n          }\n        ]\n      }\n    ];\n\n    let savedPaperIds = new Set([\"cit3110-final-2025\"]);\n    let showSavedOnly = false;\n\n    function renderPapers(list) {\n      const grid = document.getElementById(\"papersGrid\");\n      const heading = document.getElementById(\"resultsCountHeading\");\n      const badge = document.getElementById(\"savedCounterBadge\");\n      badge.textContent = `Saved for Revision: ${savedPaperIds.size}`;\n      heading.textContent = `Showing ${list.length} Past Exam Paper${list.length === 1 ? \"\" : \"s\"}`;\n\n      if (list.length === 0) {\n        grid.innerHTML = `\n          <div class=\"col-span-full bg-white border border-slate-200 rounded-xl p-8 text-center\">\n            <p class=\"text-sm font-semibold text-slate-800\">No matching past exam papers found.</p>\n            <p class=\"text-xs text-slate-500 mt-1\">Try clearing your search box or switching the department/year filter.</p>\n          </div>\n        `;\n        return;\n      }\n\n      grid.innerHTML = list.map(paper => {\n        const isSaved = savedPaperIds.has(paper.id);\n        return `\n          <article class=\"bg-white rounded-xl border border-slate-200 p-5 flex flex-col justify-between hover:border-blue-500 transition\">\n            <div>\n              <div class=\"flex justify-between items-start gap-2 mb-3\">\n                <span class=\"inline-block text-xs font-bold px-2.5 py-1 rounded bg-blue-50 text-blue-800 border border-blue-200\">\n                  ${paper.courseCode}\n                </span>\n                <div class=\"flex items-center gap-1.5\">\n                  <span class=\"text-xs font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-700\">\n                    ${paper.examType} • ${paper.year}\n                  </span>\n                  <button\n                    onclick=\"toggleSavePaper('${paper.id}')\"\n                    class=\"text-xs px-2 py-0.5 rounded border ${isSaved ? 'bg-amber-50 border-amber-300 text-amber-800 font-semibold' : 'bg-white border-slate-200 text-slate-500 hover:text-slate-800'}\"\n                    title=\"Bookmark for final exam revision\"\n                  >\n                    ${isSaved ? '★ Saved' : '☆ Save'}\n                  </button>\n                </div>\n              </div>\n\n              <h4 class=\"font-bold text-slate-900 text-base mb-1\">${paper.courseTitle}</h4>\n              <p class=\"text-xs text-slate-500 mb-3\">${paper.semester} • ${paper.duration} • ${paper.totalMarks}</p>\n\n              <div class=\"flex flex-wrap gap-1.5 mb-4\">\n                ${paper.topics.map(t => `<span class=\"text-[11px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded\">${t}</span>`).join(\"\")}\n              </div>\n            </div>\n\n            <div class=\"pt-3 border-t border-slate-100 flex items-center justify-between gap-2\">\n              <span class=\"text-xs text-slate-500\">${paper.questions.length} Exam Questions Included</span>\n              <button\n                onclick=\"openPaperModal('${paper.id}')\"\n                class=\"bg-slate-900 hover:bg-blue-700 text-white text-xs font-semibold px-3.5 py-2 rounded-lg transition\"\n              >\n                View Questions &amp; Key\n              </button>\n            </div>\n          </article>\n        `;\n      }).join(\"\");\n    }\n\n    function filterPapers() {\n      const q = document.getElementById(\"searchInput\").value.trim().toLowerCase();\n      const dept = document.getElementById(\"departmentSelect\").value;\n      const year = document.getElementById(\"yearSelect\").value;\n\n      const filtered = examPapers.filter(p => {\n        const matchesQuery = !q ||\n          p.courseCode.toLowerCase().includes(q) ||\n          p.courseTitle.toLowerCase().includes(q) ||\n          p.topics.some(t => t.toLowerCase().includes(q));\n        const matchesDept = dept === \"ALL\" || p.department === dept;\n        const matchesYear = year === \"ALL\" || p.year === year;\n        const matchesSaved = !showSavedOnly || savedPaperIds.has(p.id);\n        return matchesQuery && matchesDept && matchesYear && matchesSaved;\n      });\n\n      renderPapers(filtered);\n    }\n\n    function setQuickCourse(code) {\n      document.getElementById(\"searchInput\").value = code === \"ALL\" ? \"\" : code;\n      filterPapers();\n    }\n\n    function resetFilters() {\n      document.getElementById(\"searchInput\").value = \"\";\n      document.getElementById(\"departmentSelect\").value = \"ALL\";\n      document.getElementById(\"yearSelect\").value = \"ALL\";\n      showSavedOnly = false;\n      document.getElementById(\"showSavedOnlyBtn\").className =\n        \"text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 transition\";\n      filterPapers();\n    }\n\n    function toggleSavePaper(id) {\n      if (savedPaperIds.has(id)) {\n        savedPaperIds.delete(id);\n      } else {\n        savedPaperIds.add(id);\n      }\n      filterPapers();\n    }\n\n    function toggleSavedFilter() {\n      showSavedOnly = !showSavedOnly;\n      const btn = document.getElementById(\"showSavedOnlyBtn\");\n      btn.className = showSavedOnly\n        ? \"text-xs font-semibold px-3 py-1.5 rounded-lg border border-amber-400 bg-amber-50 text-amber-900 transition\"\n        : \"text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-100 text-slate-700 transition\";\n      filterPapers();\n    }\n\n    function openPaperModal(id) {\n      const paper = examPapers.find(p => p.id === id);\n      if (!paper) return;\n\n      document.getElementById(\"modalBadge\").textContent = `${paper.courseCode} • ${paper.examType} (${paper.year})`;\n      document.getElementById(\"modalTitle\").textContent = paper.courseTitle;\n      document.getElementById(\"modalMeta\").textContent = `${paper.semester} | Duration: ${paper.duration} | Maximum Marks: ${paper.totalMarks}`;\n\n      const container = document.getElementById(\"modalQuestionsContainer\");\n      container.innerHTML = paper.questions.map((item, idx) => `\n        <div class=\"border border-slate-200 rounded-lg p-4 bg-white\">\n          <div class=\"flex justify-between items-center mb-2\">\n            <span class=\"text-xs font-bold text-blue-800 bg-blue-50 px-2.5 py-0.5 rounded border border-blue-200\">${item.qNum}</span>\n            <button\n              onclick=\"toggleSingleAnswer(${idx})\"\n              class=\"text-xs font-semibold text-blue-700 hover:underline\"\n            >\n              Show / Hide Model Answer\n            </button>\n          </div>\n          <p class=\"text-sm text-slate-900 font-medium leading-relaxed\">${item.question}</p>\n          <div id=\"answer-box-${idx}\" class=\"hidden mt-3 pt-3 border-t border-slate-200 bg-emerald-50/60 p-3 rounded text-xs text-slate-800 leading-relaxed\">\n            <strong class=\"text-emerald-900 block mb-1\">✓ Official Model Answer Key:</strong>\n            ${item.answer}\n          </div>\n        </div>\n      `).join(\"\");\n\n      const modal = document.getElementById(\"paperModal\");\n      modal.classList.remove(\"hidden\");\n      modal.classList.add(\"flex\");\n    }\n\n    function openQuickQuiz() {\n      openPaperModal(\"cit3110-final-2025\");\n    }\n\n    function toggleSingleAnswer(idx) {\n      const box = document.getElementById(`answer-box-${idx}`);\n      if (box) box.classList.toggle(\"hidden\");\n    }\n\n    function toggleAllAnswers(show) {\n      const boxes = document.querySelectorAll(\"[id^='answer-box-']\");\n      boxes.forEach(b => {\n        if (show) b.classList.remove(\"hidden\");\n        else b.classList.add(\"hidden\");\n      });\n    }\n\n    function closePaperModal() {\n      const modal = document.getElementById(\"paperModal\");\n      modal.classList.add(\"hidden\");\n      modal.classList.remove(\"flex\");\n    }\n\n    // Initial render\n    filterPapers();\n  </script>\n</body>\n</html>",
